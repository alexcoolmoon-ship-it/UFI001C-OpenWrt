#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=1
start_service() {
	[ "$(uci -q get ufi-modem-watchdog.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/ufi-modem-watchdog watch
	procd_set_param respawn 3600 10 3
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
