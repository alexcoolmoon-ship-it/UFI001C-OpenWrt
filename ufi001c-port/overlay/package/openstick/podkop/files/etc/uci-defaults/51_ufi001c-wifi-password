#!/bin/sh
# UFI001C: set WiFi password on first boot (v3.2.7+)
# SSID stays as configured; encryption WPA2-PSK, key 1234567890
. /lib/functions.sh

# Enable radio (in case it's disabled by default)
for radio in $(uci show wireless 2>/dev/null | grep "wireless\..*\.disabled='1'" | cut -d. -f2 | cut -d= -f1); do
  uci set wireless.$radio.disabled='0'
done

# Set WPA2 password on all AP interfaces
for iface in $(uci show wireless 2>/dev/null | grep "=wifi-iface" | cut -d. -f2 | cut -d= -f1); do
  mode=$(uci get wireless.$iface.mode 2>/dev/null)
  if [ "$mode" = "ap" ]; then
    uci set wireless.$iface.encryption='psk2'
    uci set wireless.$iface.key='1234567890'
  fi
done

uci commit wireless
exit 0
